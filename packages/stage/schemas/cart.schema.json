{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "title",
    "build",
    "blobDigest",
    "size"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "enum": [
        "w4"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 128
    },
    "build": {
      "type": "integer",
      "minimum": 1
    },
    "blobDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "note": {
      "type": "string",
      "maxLength": 4000
    },
    "controls": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
